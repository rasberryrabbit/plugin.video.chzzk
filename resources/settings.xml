<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings>
    <!-- Login (Naver Credentials) -->
    <category label="30100">
        <setting label="30102" type="lsep"/>
        <setting id="nid_aut" type="text" label="30103" default=""/>
        <setting id="nid_ses" type="text" label="30104" default=""/>
        <setting label="30105" type="lsep"/>
        <setting label="30106" type="lsep"/>
        <setting label="30107" id="open_naver" type="action" action="RunPlugin(plugin://$ID/?mode=settings)" option="close"/>
    </category>
    <!-- Playback -->
    <category label="30200">
        <setting id="use_inputstream_adaptive" type="bool" label="30206" default="true"/>
        <setting id="prefer_quality" type="enum" label="30207" lvalues="30208|30209|30210|30211" default="1"/>
        <setting id="show_live_indicator" type="bool" label="30212" default="true"/>
        <setting id="show_viewer_count" type="bool" label="30213" default="true"/>
    </category>
    <!-- Cache -->
    <category label="30300">
        <setting id="cache_duration" type="slider" label="30304" default="5" range="0,60" option="int"/>
        <setting label="30305" id="clear_cache" type="action" action="RunPlugin(plugin://$ID/?mode=clear_cache)" option="close"/>
    </category>
    <!-- Advanced -->
    <category label="30400">
        <setting id="enable_logging" type="bool" label="30411" default="false"/>
        <setting label="30412" type="lsep"/>
        <setting id="api_base_url" type="text" label="30413" default="https://api.chzzk.naver.com/service"/>
    </category>
</settings>
